---
import { projects } from "../data/site";
---

<section id="projects" class="section" aria-labelledby="projects-heading">
  <div class="wrap">
    <h2 id="projects-heading" class="display text-3xl sm:text-4xl">Projects</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {
        projects.map((project) => (
          <article class="flex flex-col border border-line bg-surface p-6 sm:p-7">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="display text-2xl">{project.name}</h3>
              <p class="shrink-0 font-mono text-sm text-muted">{project.status}</p>
            </div>
            <p class="mt-4 leading-relaxed">{project.summary}</p>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${project.name} stack`}>
              {project.stack.map((item) => (
                <li class="bg-chip px-2.5 py-1 font-mono text-sm">{item}</li>
              ))}
            </ul>
            <p class="mt-6">
              <a class="underline underline-offset-4" href={project.href} rel="noreferrer" target="_blank">
                GitHub
                <span class="sr-only"> for {project.name} (opens in a new tab)</span>
              </a>
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
