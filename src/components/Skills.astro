---
import { skillGroups } from "../data/site";
---

<section id="skills" class="section" aria-labelledby="skills-heading">
  <div class="wrap">
    <h2 id="skills-heading" class="display text-3xl sm:text-4xl">Skills</h2>
    <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        skillGroups.map((group) => (
          <section aria-labelledby={`skill-${group.title.toLowerCase()}`}>
            <h3 id={`skill-${group.title.toLowerCase()}`} class="font-mono text-sm text-muted">
              {group.title}
            </h3>
            <ul class="mt-3 space-y-1.5">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>
